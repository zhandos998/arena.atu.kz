APP_NAME="ATU Code Arena"
APP_KEY=base64:replace-with-php-artisan-key-generate-show
APP_URL=https://arena.atu.kz
APP_TIMEZONE=Asia/Almaty
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
LOG_LEVEL=warning

DOCKER_PROJECT_PATH=/opt/apps/arena
DOCKER_HTTP_PORT=8122
DOCKER_PHPMYADMIN_PORT=8123
PHPMYADMIN_URL=https://arena.atu.kz/phpmyadmin/

DOCKER_DB_DATABASE=arena
DOCKER_DB_USERNAME=arena
DOCKER_DB_PASSWORD=replace-with-a-long-random-password
DOCKER_DB_ROOT_PASSWORD=replace-with-another-long-random-password

JUDGE_DOCKER_WORKSPACE_PATH=/opt/apps/arena/storage/app/judge
JUDGE_CONTAINER_STARTUP_GRACE_SECONDS=5
